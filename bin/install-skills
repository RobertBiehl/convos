#!/usr/bin/env bash
set -euo pipefail

target="${1:-all}"
case "$target" in codex|claude|antigravity|both|all) ;; *) echo "usage: $0 [codex|claude|antigravity|both|all]" >&2; exit 1 ;; esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
skill="$root/skills/convos/SKILL.md"
[ -f "$skill" ] || { echo "missing skill: $skill" >&2; exit 1; }

install() {
  base="$1"
  mkdir -p "$base/convos"
  cp -f "$skill" "$base/convos/SKILL.md"
  legacy="$base/agent-convos/SKILL.md"
  if [ ! -L "$legacy" ] && [ -f "$legacy" ] && cmp -s "$legacy" <(sed -e '0,/name: convos/s//name: agent-convos/' -e '0,/# Convos/s//# Agent Convos/' "$skill"); then rm "$legacy"; echo "Removed legacy $legacy"; fi
  echo "Installed to $base/convos"
}

codex_base="${CODEX_HOME:-$HOME/.codex}/skills"
claude_base="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
antigravity_base="${ANTIGRAVITY_CONFIG_DIR:-$HOME/.gemini/config}/skills"

if [ "$target" = "codex" ] || [ "$target" = "both" ] || [ "$target" = "all" ]; then install "$codex_base"; fi
if [ "$target" = "claude" ] || [ "$target" = "both" ] || [ "$target" = "all" ]; then install "$claude_base"; fi
if [ "$target" = "antigravity" ] || [ "$target" = "all" ]; then install "$antigravity_base"; fi
